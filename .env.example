# CampusConnect environment template
# Copy this file to `.env` and fill in your own values.

PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/campusconnect
MONGO_DB_NAME=campusconnect
USE_MEMORY_DB=false
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
REFRESH_SECRET=replace-with-a-long-refresh-secret
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CampusConnect <no-reply@example.com>
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RESEND_API_KEY=
EMAIL_FROM=
FIREBASE_SERVER_KEY=
FIREBASE_MESSAGING_KEY=
SMS_PROVIDER=MOCK

AI_PORT=8000
NODE_BACKEND_URL=http://localhost:5001/api
HOST=0.0.0.0
